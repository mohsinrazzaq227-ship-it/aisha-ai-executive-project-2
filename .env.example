# ---------------------------------------------------------------------------
# AISHA — environment template. Copy to .env and edit. NO SECRETS SHIP HERE.
# Every value below is optional: AISHA starts, plans and executes with the
# deterministic engine, and the Doctor reports exactly what is missing.
# ---------------------------------------------------------------------------

# Database (required)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# HTTP port for the local AISHA service + Electron host
PORT=3000

# ---- Local LLM (free, offline). Without it AISHA uses the deterministic
# planner and says so in every task record.
OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1:8b          # leave unset for runtime model discovery
OLLAMA_TIMEOUT_MS=60000

# ---- Optional cloud LLM. Disabled unless explicitly enabled AND keyed.
AISHA_ENABLE_CLOUD_LLM=false
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ---- Python sidecar (Windows computer-use, screen capture, OCR, STT/TTS bridge)
# AISHA_PYTHON=python
# AISHA_SIDECAR=python/worker/aisha_worker.py
# AISHA_SIDECAR_DISABLED=true

# ---- Local speech engines (optional; browser speech APIs are the labelled fallback)
# WHISPER_URL=http://127.0.0.1:8178
# TTS_URL=http://127.0.0.1:5002

# ---- Media binaries (bundled ffmpeg-static/ffprobe-static are probed first)
# FFMPEG_PATH=
# FFPROBE_PATH=

# ---- Browser automation (playwright package is installed; chromium is not)
# PLAYWRIGHT_CHROMIUM_EXECUTABLE=
# AISHA_BROWSER_HEADLESS=true

# ---- Email (optional; sending is HIGH risk and always requires approval)
# IMAP_URL=imaps://user:password@imap.example.com:993
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=you@example.com
# EMAIL_DEFAULT_TO=you@example.com

# ---- AI media providers (optional; deterministic ffmpeg/PNG renderers are default)
# AISHA_IMAGE_API_URL=
# AISHA_IMAGE_API_KEY=
# AISHA_VIDEO_API_URL=
# AISHA_VIDEO_API_KEY=

# ---- Security / approvals
# AISHA_APPROVAL_SECRET=            # auto-derived from install path when unset
# AISHA_ALLOWED_COMMANDS=           # comma-separated allowlist; empty = deny-list only

# ---- Workspace / resource limits
# AISHA_ROOT=
# AISHA_MIN_FREE_RAM_MB=400
