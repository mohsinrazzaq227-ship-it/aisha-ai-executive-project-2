# ---------------------------------------------------------------------------
# AI-EXECUTIVE — environment template. Copy to .env and edit. NO SECRETS SHIP HERE.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Storage. All directories are created automatically; only set these to relocate them.
# AI_EXECUTIVE_ROOT=
# AI_EXECUTIVE_DATA_DIR=
# AI_EXECUTIVE_DOCUMENTS_DIR=
PORT=3000

# ---- Local LLM (free, offline). Never required: without it the deterministic
# local planner and scriptwriter are used and the UI says so.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b

# ---- Optional cloud LLM. Disabled unless you opt in EXPLICITLY.
AI_EXECUTIVE_ENABLE_CLOUD_LLM=false
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
# GROQ_API_KEY=
# OPENROUTER_API_KEY=

# ---- Local speech. Recommended: real word-level captions and narration in MP4.
# WHISPER_URL=http://127.0.0.1:8178
# TTS_URL=http://127.0.0.1:5002

# ---- Media binaries (optional: bundled ffmpeg-static/ffprobe-static are used first)
# FFMPEG_PATH=
# FFPROBE_PATH=

# ---- Email (all optional; sending always requires approval)
# IMAP_URL=imaps://user:password@imap.example.com:993
# SMTP_URL=smtps://user:password@smtp.example.com:465
# SMTP_FROM=you@example.com
# EMAIL_DEFAULT_TO=you@example.com
# GMAIL_REFRESH_TOKEN=
# MS_GRAPH_TOKEN=

# ---- Approval signing secret (auto-derived from the install path when unset)
# APPROVAL_SECRET=
