{
  "$comment": "AISHA runtime configuration. No machine-specific paths and no secrets. Probed live by the Doctor; nothing here is assumed available.",
  "autonomy": {
    "maxConcurrentSteps": 4,
    "maxConcurrentHeavy": 1,
    "maxStepAttempts": 2,
    "stepTimeoutMs": 120000,
    "taskTimeoutMs": 900000,
    "walkRealism": true
  },
  "approvals": {
    "ttlMinutes": 15,
    "enforceActionHash": true
  },
  "uploads": {
    "maxBytes": 104857600,
    "allowedExtensions": [
      ".pdf", ".txt", ".md", ".csv", ".json", ".html", ".docx", ".xlsx",
      ".png", ".jpg", ".jpeg", ".webp", ".mp3", ".wav", ".mp4", ".mov", ".webm"
    ]
  },
  "media": {
    "fps": 24,
    "crf": 26,
    "resolution": { "width": 1280, "height": 720 },
    "videoCodec": "libx264",
    "audioCodec": "aac"
  },
  "resource": {
    "minFreeRamMb": 400,
    "heavyCpuLoadPerCore": 1.6,
    "sampleIntervalMs": 5000
  },
  "workspace": {
    "protectedPaths": [
      "C:\\Windows", "C:\\Program Files", "C:\\Program Files (x86)", "C:\\ProgramData",
      "/etc", "/bin", "/sbin", "/usr", "/boot", "/proc", "/sys", "/dev"
    ]
  }
}
